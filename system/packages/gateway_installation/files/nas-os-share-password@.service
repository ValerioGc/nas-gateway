# Writes the password the gateway hands over into the passwords of Samba, for the user of the
# shared folders, through share-password.sh. It reads the request from the connection of
# nas-os-share-password.socket and answers on it.
# The password is never on a command line nor in the journal.
# Installed by `system/packages/gateway_installation/install.sh`.

[Unit]
Description=Password of the shared folders for Samba

[Service]
ExecStart=/usr/local/lib/nas-os-gateway/share-password.sh
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=30
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=-/var/lib/samba -/run/samba -/var/cache/samba
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
