# Where the gateway hands the password of the account to Samba, for the folders shared on the
# local network: one connection, one run of nas-os-share-password@.service. Only the group
# nas-os-share-password may connect, and the gateway is its one member (SupplementaryGroups= in
# nas-os-gateway.service). Installed by `system/packages/gateway_installation/install.sh`.

[Unit]
Description=Password of the shared folders, from the gateway

[Socket]
ListenStream=/run/nas-os-share-password.sock
SocketUser=root
SocketGroup=nas-os-share-password
SocketMode=0660
Accept=yes
MaxConnections=2
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
